# Copy to .env.local and fill in real values. Server-side only unless prefixed NEXT_PUBLIC_.

# Public site URL (used for canonical URLs, sitemap, and OpenGraph).
NEXT_PUBLIC_SITE_URL=https://terraliberia.com

# SeoJama headless API — powers the /news section.
SEOJAMA_API_BASE=https://seojama.com/api/v1
SEOJAMA_WORKSPACE_ID=your-workspace-uuid
SEOJAMA_API_KEY=your-headless-integration-key

# Mailgun — powers the contact form.
MAILGUN_KEY=your-mailgun-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_API_BASE=https://api.mailgun.net
CONTACT_TO=info@yourdomain.com
CONTACT_FROM=Terra Investment Group <no-reply@mg.yourdomain.com>

# Cloudflare Turnstile (anti-spam). Leave both blank to disable the captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
